# ============================================================
# GeoRetail Guatemala — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
POSTGRES_DB=georetail
POSTGRES_USER=georetail
POSTGRES_PASSWORD=georetail_secret

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=4000

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000

# --- Maps ---
# Mapbox token (optional — app will use Leaflet/OSM as free fallback)
VITE_MAPBOX_TOKEN=

# --- External APIs ---
# Overpass API for OSM data (default public endpoint)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Auth (for Admin panel — MVP uses simple token) ---
ADMIN_SECRET=change_me_in_production

# --- Feature Flags ---
# Set to true to enable data refresh from Overpass on startup
REFRESH_OSM_ON_STARTUP=false
